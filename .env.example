# Copy to .env (in the repo root) and fill in for local development. Never commit .env.
# The API and worker check these at start-up (packages/shared/src/env.ts) and
# stop with a list of what's missing. First time on Windows without Docker:
# run infra/setup-local-db.cmd to create the database users.

NODE_ENV=development
LOG_LEVEL=info

# Database — two users (docs/blueprint.md "Multi-tenant safety"):
# the API's everyday user, kept to one shop's rows by row-level security...
DATABASE_URL="postgresql://khmer_micro_store_app:khmer_micro_store_app@localhost:5432/khmer_micro_store"
# ...and the owner: migrations, the worker, and the API's login and sign-up.
DATABASE_OWNER_URL="postgresql://khmer_micro_store:khmer_micro_store@localhost:5432/khmer_micro_store"

# API (apps/api)
PORT=4000
# The web app: the only site(s) allowed to call the API from a browser; the first is the base of links
# in Telegram alerts. Several, comma-separated, to test on a phone: http://localhost:3000,http://192.168.x.x:3000
WEB_ORIGIN="http://localhost:3000"

# Photos. FILE_STORAGE=local keeps them in FILES_DIR, served by the API's /files (simplest).
# FILE_STORAGE=s3 keeps them in an S3 bucket: Cloudflare R2 in production (required there), or
# locally SeaweedFS: run "pnpm s3:up" (leave it running), then once "pnpm files:setup", and
# "pnpm files:copy-to-s3" to bring over photos you already have. Check any time: "pnpm files:check".
FILE_STORAGE=local
FILES_DIR=.uploads
# FILES_PUBLIC_URL=        (unset = http://localhost:<PORT>/files; with s3, the bucket's public address)
# Local SeaweedFS (logins from infra/local-s3.json, used nowhere else):
# FILE_STORAGE=s3
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=khmio-photos
# S3_ACCESS_KEY_ID=localdev
# S3_SECRET_ACCESS_KEY=localdev-secret
# FILES_PUBLIC_URL=http://localhost:9000/khmio-photos
#   (phones on Wi-Fi: start with "set S3_LAN=1 && pnpm s3:up" and use http://<PC's Wi-Fi address>:9000/khmio-photos)
# Cloudflare R2: S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com, S3_REGION=auto,
# keys from an R2 API token (Object Read & Write, this bucket only), FILES_PUBLIC_URL=https://files.<domain>

# Error tracking: leave empty to keep errors on this machine.
SENTRY_DSN=

# Telegram bot (from @BotFather): login and order alerts. Empty = Telegram login off (the development
# login still works) and the worker only logs the alerts it would send (dry run).
TELEGRAM_BOT_TOKEN=

# Admin two-step login: encrypts each admin's authenticator secret. 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Empty = the admin login is off. Lost = every admin sets up two-step login again (pnpm admin:add-owner).
ADMIN_SECRETS_KEY=

# Behind Railway and Cloudflare: how many proxies add to X-Forwarded-For before the API (rate limits
# read the buyer's address that many steps from the right). 0 locally. Count them; too high lets anyone
# pick their own address.
TRUST_PROXY_HOPS=0

# Cloudflare Turnstile (bot check on checkout). Empty = no check (local). Required in production.
# Test keys from Cloudflare's docs: secret 1x0000000000000000000000000000000AA always passes,
# 2x0000000000000000000000000000000AA always fails. The web app needs the matching site key.
TURNSTILE_SECRET_KEY=

# Rate limits on login, checkout, links and uploads. "off" only for end-to-end test scripts; never in production.
RATE_LIMITS=on

# KHQR for buyers (API and worker). "off" until the Bakong token arrives. "fake" = a stand-in bank inside the
# API (/dev/fake-bank) so the whole pay-by-KHQR flow runs locally; the buyer's page gets a "pay (test)" button.
# Production refuses "fake". The worker asks the stand-in bank at FAKE_BANK_URL (default http://localhost:4000/dev/fake-bank).
KHQR_PROVIDER=off

# Nightly database backup (worker, 03:00 Phnom Penh): pg_dump into a PRIVATE bucket of its own - never
# the photos bucket, which anyone can read. Kept BACKUP_KEEP_DAYS (the newest 3 always stay). Required
# in production. Uses the S3_* settings above. Back up now: "pnpm db:backup"; list: "pnpm db:backup -- --list";
# bring one back into a new, empty database: RESTORE_DATABASE_URL=... "pnpm db:restore -- --from latest".
BACKUPS=off
# S3_BACKUP_BUCKET=khmio-backups
# BACKUP_KEEP_DAYS=14
# On Windows, pg_dump/pg_restore aren't on the PATH (the worker's Docker image has them):
# PG_DUMP_PATH=C:/Program Files/PostgreSQL/16/bin/pg_dump.exe
# PG_RESTORE_PATH=C:/Program Files/PostgreSQL/16/bin/pg_restore.exe

# Bakong Open API - roadmap step 5
BAKONG_OPEN_API_TOKEN=

# ABA PayWay - Release 3
PAYWAY_MERCHANT_ID=
PAYWAY_API_KEY=
PAYWAY_KEY_ENCRYPTION_KEY=

# Web (apps/web) reads its own apps/web/.env.local, not this file:
#   NEXT_PUBLIC_API_URL=http://localhost:4000        (default if unset; in development a local address — localhost,
#                                                    192.168.x … — follows the address the site is opened with, so a
#                                                    new Wi-Fi needs no change here. Production uses it exactly.)
#   NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=your_bot_name  (shows the Telegram button)
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=                  (bot check on checkout and the website waitlist; test key 1x00000000000000000000AA)
#   NEXT_PUBLIC_SITE_URL=http://localhost:3000       (the website's public address: link previews, sitemap)
#   NEXT_PUBLIC_FILES_ORIGIN=                        (where photos come from, if not the API: R2 or local S3)

# Production refuses to start unless WEB_ORIGIN (and FILES_PUBLIC_URL, if set) are https and
# TELEGRAM_BOT_TOKEN, ADMIN_SECRETS_KEY and TURNSTILE_SECRET_KEY are set.

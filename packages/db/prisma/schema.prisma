// The database, following docs/blueprint.md "Database schema". Each roadmap
// step adds its own tables in a new migration; old migrations are never edited.
// Step 2 (data and login): people, login, stores, the trial subscription,
// categories and units, sessions, platform settings and the audit log.
// Step 3 (catalog): brands, products, variants, photos.
// Step 4 (shop and checkout): delivery zones and drivers, customers, orders.
// Step 6 (orders and Telegram): how each order was sent, and the outbox of messages.
// Step 7 (admin): admin users with two-step login, their backup codes and sessions.
// Release 1 complete: staff Telegram groups, buyers following an order, one-time Telegram link codes.
//
// Row-level security (in the migration SQL, which Prisma can't express) keeps
// every shop to its own rows for the API's everyday user, khmer_micro_store_app.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // The API's everyday user: row-level security applies.
  url       = env("DATABASE_URL")
  // The owner: migrations run as this user.
  directUrl = env("DATABASE_OWNER_URL")
}

// ---------------------------------------------------------------- value lists
// Same names as packages/shared, so a value means the same thing everywhere.

enum KycStatus {
  not_submitted
  pending
  approved
  rejected
}

enum LoginMethod {
  telegram
  phone
  google
}

enum StoreRole {
  owner
  staff
}

enum BusinessType {
  shop
  restaurant
  service
  garage
  other
}

/// What a shop's kind of business needs beyond the core (packages/shared business-modules.ts).
enum BusinessModule {
  options
  choices
  customFields
  services
  tables
  jobCards
}

enum DeliveryArea {
  phnom_penh
  province
}

enum Currency {
  USD
  KHR
}

enum PaymentProvider {
  bakong_khqr
  aba_payway
}

enum PlanId {
  free
  basic
  pro
  advance
}

enum SubscriptionStatus {
  trialing
  active
  grace
  paused
}

enum ActorType {
  admin
  merchant
  system
}

enum OrderStatus {
  awaiting_payment
  paid
  cod_pending
  confirmed
  packing
  waiting_for_driver
  out_for_delivery
  delivered
  completed
  cancelled
  failed_delivery
}

enum PaymentMethod {
  khqr
  aba_payway
  cod
  /// Paid in cash at the counter (design/screens.md P2) — not cash on delivery.
  cash
  /// The seller's own uploaded QR at the counter, checked by the seller in their bank app.
  shop_qr
}

enum StockLocationType {
  warehouse
  branch
}

enum StockMovementType {
  purchase
  sale
  transfer_out
  transfer_in
  adjust_in
  adjust_out
}

enum StockAdjustmentReason {
  count_correction
  damaged
  lost
  returned
  other
  /// Sent back to the supplier (a purchase return).
  supplier_return
  /// Went down: past its date.
  expired
  /// Went down: used in the shop (a repair, its own use).
  own_use
  /// Went down: given away (a gift, a sample).
  given_away
  /// Went up: free goods from a supplier.
  free_goods
  /// What was on the shelf when the item started being tracked (may carry its cost).
  opening_stock
}

/// An option group either makes variants (Size × Colour) or adds choices at order time (Sugar, Add-ons).
enum OptionGroupKind {
  variant
  choice
}

/// A choice group lets the buyer pick one value, or any number.
enum ChoicePick {
  one
  many
}

/// A job card's life: booked in, being worked on, ready to collect, handed over (billed) or cancelled.
enum JobCardStatus {
  open
  in_progress
  ready
  handed_over
  cancelled
}

/// A product is an item, or a service: no stock, nothing to deliver (packages/shared services.ts).
enum ProductKind {
  item
  service
}

/// Where a shop's own field sits (packages/shared custom-fields.ts).
enum CustomFieldTarget {
  product
  orderLine
}

enum CustomFieldType {
  text
  number
  date
  yesNo
  pick
}

/// One try to pay an order online (packages/shared payment-attempts.ts).
enum PaymentAttemptStatus {
  pending
  paid
  expired
  failed
}

/// Why a payment check needs a person to look (packages/shared payment-attempts.ts).
enum PaymentCheckIssue {
  provider_unreachable
  amount_mismatch
  currency_mismatch
  paid_after_expiry
}

/// An issue's handling: open, confirmed by an admin as real, or closed with a note.
enum PaymentIssueStatus {
  open
  confirmed
  closed
}

/// Where the order was made: the shop page, or the counter (design/screens.md P1).
enum OrderChannel {
  online
  in_store
}

enum Fulfilment {
  delivery
  pickup
  /// Sold at the counter: handed over on the spot.
  in_store
}

enum DriverKind {
  own
  partner
}

enum OrderCancelReason {
  payment_timeout
  buyer_cancelled
  out_of_stock
  cannot_deliver
  other
  /// A sale at the counter undone by the seller (the money handed back by hand).
  counter_void
}

enum OrderActor {
  buyer
  merchant
  system
}

enum DispatchRoute {
  driver
  bus
  pickup
}

enum AdminRole {
  owner
  support
  finance
}

enum TelegramLinkKind {
  /// "Add the bot to your staff group": links a group to a shop.
  group_link
  /// "Get updates on Telegram": links a buyer's chat to an order.
  order_follow
}

enum AdminSessionStage {
  /// Telegram (or the development login) passed; the authenticator code is still to come.
  pending_2fa
  active
}

// ---------------------------------------------------------- people and login

/// A person who owns or works in stores.
model Merchant {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName String    @map("first_name")
  lastName  String    @default("") @map("last_name")
  kycStatus KycStatus @default(not_submitted) @map("kyc_status")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  identities      MerchantIdentity[]
  memberships     StoreMember[]
  salesMade       Order[]            @relation("OrderSoldBy")
  stockMoves      StockMovement[]
  purchases       Purchase[]
  billPayments    PurchasePayment[]  @relation("PaymentRecordedBy")
  receivedBills   Purchase[]         @relation("PurchaseReceivedBy")
  voidedPayments  PurchasePayment[]  @relation("PaymentVoidedBy")
  countsStarted   StockCount[]       @relation("CountStartedBy")
  countsApplied   StockCount[]       @relation("CountAppliedBy")
  countsCancelled StockCount[]       @relation("CountCancelledBy")
  sessions        Session[]

  @@map("merchants")
}

/// How a merchant logs in — one row per method. A merchant always keeps at least one.
model MerchantIdentity {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId       String      @map("merchant_id") @db.Uuid
  method           LoginMethod
  /// Telegram user ID, or the phone as 855…
  providerUserId   String      @map("provider_user_id")
  telegramUsername String?     @map("telegram_username")
  verifiedAt       DateTime    @default(now()) @map("verified_at") @db.Timestamptz(6)
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([method, providerUserId])
  @@index([merchantId])
  @@map("merchant_identities")
}

/// A signed-in device. The cookie holds a random token; only its SHA-256 is stored.
model Session {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId String    @map("merchant_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@map("sessions")
}

/// Who can manage a store.
model StoreMember {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId    String    @map("store_id") @db.Uuid
  merchantId String    @map("merchant_id") @db.Uuid
  role       StoreRole @default(owner)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([storeId, merchantId])
  @@index([merchantId])
  @@map("store_members")
}

// ----------------------------------------------------------------------- shop

/// A shop. The plan is not here — it lives on subscriptions only.
model Store {
  id                      String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                    String           @unique
  name                    String
  businessType            BusinessType     @map("business_type")
  /// Switched-on modules; a new shop gets its business type's set (BUSINESS_TYPE_MODULES).
  modules                 BusinessModule[] @default([])
  /// 855…; empty until the seller adds it (needed before sharing the shop link).
  phone                   String           @default("")
  area                    DeliveryArea     @default(phnom_penh)
  description             String           @default("")
  logoKey                 String?          @map("logo_key")
  languages               String[]         @default(["km", "en"])
  defaultCurrency         Currency         @default(USD) @map("default_currency")
  usdToKhrRate            Int              @default(4100) @map("usd_to_khr_rate")
  allowCod                Boolean          @default(true) @map("allow_cod")
  /// Most small sellers don't charge VAT, so a new store starts at 0%.
  vatPercent              Int              @default(0) @map("vat_percent")
  onlineStockLocationId   String?          @map("online_stock_location_id") @db.Uuid
  pickupEnabled           Boolean          @default(false) @map("pickup_enabled")
  pickupAddress           String           @default("") @map("pickup_address")
  pickupHours             String           @default("") @map("pickup_hours")
  provinceDeliveryEnabled Boolean          @default(false) @map("province_delivery_enabled")
  provinceFeeUsdCents     Int?             @map("province_fee_usd_cents")
  provinceFeeKhr          Int?             @map("province_fee_khr")
  provinceNote            String           @default("") @map("province_note")
  deliveryConfiguredAt    DateTime?        @map("delivery_configured_at") @db.Timestamptz(6)
  linkSharedAt            DateTime?        @map("link_shared_at") @db.Timestamptz(6)
  /// On invoices (design/screens.md B7); empty = not shown.
  taxNumber               String           @default("") @map("tax_number")
  invoiceNote             String           @default("") @map("invoice_note")
  telegramLink            String           @default("") @map("telegram_link")
  facebookLink            String           @default("") @map("facebook_link")
  /// Copied from Google Maps on Shop details; the buyer's Map button opens it (design/screens.md S10). Empty = search the pickup address.
  mapUrl                  String           @default("") @map("map_url")
  /// The seller's own payment QR picture (a storage key, like the logo), shown to buyers paying at the counter. Empty = none.
  paymentQrKey            String           @default("") @map("payment_qr_key")
  /// The last order number given out; the next order takes this + 1 (app_next_order_number()).
  lastOrderNumber         Int              @default(0) @map("last_order_number")
  createdAt               DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  members             StoreMember[]
  paymentConfigs      StorePaymentConfig[]
  subscription        Subscription?
  categories          Category[]
  units               Unit[]
  brands              Brand[]
  products            Product[]
  deliveryZones       DeliveryZone[]
  drivers             StoreDriver[]
  customers           Customer[]
  orders              Order[]
  alertChats          StoreAlertChat[]
  onlineStockLocation StockLocation?          @relation("StoreOnlineLocation", fields: [onlineStockLocationId], references: [id], onDelete: SetNull)
  stockLocations      StockLocation[]         @relation("StoreLocations")
  stockLevels         StockLevel[]
  stockMovements      StockMovement[]
  stockReservations   StockReservation[]
  paymentAttempts     PaymentAttempt[]
  optionGroups        ProductOptionGroup[]
  optionValues        ProductOptionValue[]
  variantValues       ProductVariantValue[]
  customFields        CustomFieldDefinition[]
  dineTables          DineTable[]
  vehicles            Vehicle[]
  jobCards            JobCard[]
  suppliers           Supplier[]
  purchases           Purchase[]
  purchaseLines       PurchaseLine[]
  documentCounters    DocumentCounter[]
  stockCounts         StockCount[]
  stockCountLines     StockCountLine[]
  purchasePayments    PurchasePayment[]
  jobCardLines        JobCardLine[]

  @@map("stores")
}

/// Provider settings per store. PayWay's keys join this table in Release 3, encrypted.
model StorePaymentConfig {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId         String          @map("store_id") @db.Uuid
  provider        PaymentProvider
  bakongAccountId String?         @map("bakong_account_id")
  enabled         Boolean         @default(true)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, provider])
  @@map("store_payment_configs")
}

// ------------------------------------------------------------ plan and billing

/// A store's current plan and period — the only place the plan is stored.
model Subscription {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId            String             @unique @map("store_id") @db.Uuid
  plan               PlanId             @default(free)
  status             SubscriptionStatus @default(trialing)
  currentPeriodStart DateTime           @default(now()) @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd   DateTime?          @map("current_period_end") @db.Timestamptz(6)
  trialEndsAt        DateTime?          @map("trial_ends_at") @db.Timestamptz(6)
  pendingPlan        PlanId?            @map("pending_plan")
  billingCurrency    Currency           @default(USD) @map("billing_currency")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

// --------------------------------------------------------------------- catalog

/// A store's product groups. Products arrive in roadmap step 3.
model Category {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId   String   @map("store_id") @db.Uuid
  nameKm    String   @map("name_km")
  nameEn    String   @map("name_en")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([storeId])
  @@map("categories")
}

/// Units of measure (piece, cup, kg).
model Unit {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId   String   @map("store_id") @db.Uuid
  /// The shared key it was seeded from ("piece"), so the business type's default can be found.
  key       String?
  nameKm    String   @map("name_km")
  nameEn    String   @map("name_en")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([storeId])
  @@map("units")
}

/// A store's brands.
model Brand {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId   String   @map("store_id") @db.Uuid
  nameKm    String   @map("name_km")
  nameEn    String   @map("name_en")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([storeId])
  @@map("brands")
}

/// What the shop sells. Prices live on its variants: every product has at least one.
model Product {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId         String      @map("store_id") @db.Uuid
  categoryId      String      @map("category_id") @db.Uuid
  brandId         String?     @map("brand_id") @db.Uuid
  unitId          String?     @map("unit_id") @db.Uuid
  titleKm         String      @map("title_km")
  titleEn         String      @map("title_en")
  descriptionKm   String      @default("") @map("description_km")
  descriptionEn   String      @default("") @map("description_en")
  /// 0–90; null = no discount.
  discountPercent Int?        @map("discount_percent")
  /// False = kept in the dashboard, not shown in the shop.
  isVisible       Boolean     @default(true) @map("is_visible")
  /// An item, or a service (Features › services).
  kind            ProductKind @default(item)
  /// The shop's own fields (custom_field_definitions, target product): field id → value.
  customValues    Json        @default("{}") @map("custom_values")
  deletedAt       DateTime?   @map("deleted_at") @db.Timestamptz(6)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  store        Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category     Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand        Brand?               @relation(fields: [brandId], references: [id], onDelete: SetNull)
  unit         Unit?                @relation(fields: [unitId], references: [id], onDelete: SetNull)
  variants     ProductVariant[]
  photos       ProductPhoto[]
  optionGroups ProductOptionGroup[]

  @@index([storeId, deletedAt])
  @@map("products")
}

/// The thing that is priced, stocked and ordered. A product without options has one default variant.
model ProductVariant {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId                String    @map("store_id") @db.Uuid
  productId              String    @map("product_id") @db.Uuid
  sku                    String
  labelKm                String    @default("") @map("label_km")
  labelEn                String    @default("") @map("label_en")
  /// The hidden variant of a product without options.
  isDefault              Boolean   @default(false) @map("is_default")
  priceUsdCents          Int?      @map("price_usd_cents")
  priceKhr               Int?      @map("price_khr")
  /// Pro and Advance; kept, hidden, on lower plans.
  wholesalePriceUsdCents Int?      @map("wholesale_price_usd_cents")
  wholesalePriceKhr      Int?      @map("wholesale_price_khr")
  /// What one costs the shop, in cost_currency (one currency per product): the seller's only, for profit. Empty = not known.
  /// Level 1 of the cost standard (docs/blueprint.md "Cost price"): typed by the seller; a moving average from purchases later.
  costMinor              Int?      @map("cost_minor")
  costCurrency           Currency? @map("cost_currency")
  sortOrder              Int       @default(0) @map("sort_order")
  deletedAt              DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  product           Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockLevels       StockLevel[]
  stockMovements    StockMovement[]
  stockReservations StockReservation[]
  stockCountLines   StockCountLine[]
  /// One value per variant group: "M" and "Red" make this the M · Red variant.
  values            ProductVariantValue[]
  jobCardLines      JobCardLine[]
  purchaseLines     PurchaseLine[]

  @@index([productId])
  @@map("product_variants")
}

/// A product's group of options (packages/shared product-options.ts): "Size" making variants, or "Sugar" picked at order time.
model ProductOptionGroup {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId   String          @map("store_id") @db.Uuid
  productId String          @map("product_id") @db.Uuid
  kind      OptionGroupKind
  nameKm    String          @map("name_km")
  nameEn    String          @default("") @map("name_en")
  /// Choice groups only: one value or any number.
  pick      ChoicePick      @default(one)
  /// Choice groups only: the buyer must pick before adding to the cart.
  required  Boolean         @default(false)
  sortOrder Int             @default(0) @map("sort_order")
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  store   Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  ProductOptionValue[]

  @@index([productId])
  @@map("product_option_groups")
}

/// One value of an option group: "M", "Red", "Less sugar", "+1 shot" (with its extra price).
model ProductOptionValue {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId       String   @map("store_id") @db.Uuid
  groupId       String   @map("group_id") @db.Uuid
  labelKm       String   @map("label_km")
  labelEn       String   @default("") @map("label_en")
  /// Choice values only: added to one unit's price; both empty = free.
  extraUsdCents Int?     @map("extra_usd_cents")
  extraKhr      Int?     @map("extra_khr")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  store    Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  group    ProductOptionGroup    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  variants ProductVariantValue[]

  @@index([groupId])
  @@map("product_option_values")
}

/// A garage's car (Features › jobCards): found again by its plate.
model Vehicle {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId    String   @map("store_id") @db.Uuid
  /// As printed on the plate, upper-case: "PP 2A-1234".
  plate      String
  makeModel  String   @default("") @map("make_model")
  ownerName  String   @default("") @map("owner_name")
  /// 855…; "" = not given.
  ownerPhone String   @default("") @map("owner_phone")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  jobCards JobCard[]

  @@index([storeId])
  @@map("vehicles")
}

/// One visit of one car (packages/shared job-cards.ts): what's wrong, and the parts and labour for it.
model JobCard {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId   String        @map("store_id") @db.Uuid
  vehicleId String        @map("vehicle_id") @db.Uuid
  /// 1, 2, 3… per shop.
  number    Int
  status    JobCardStatus @default(open)
  complaint String        @default("")
  mileageKm Int?          @map("mileage_km")
  /// The counter sale it was billed with ("Bill and hand over").
  orderId   String?       @map("order_id") @db.Uuid
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  store   Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  vehicle Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  order   Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  lines   JobCardLine[]

  @@unique([storeId, number])
  @@index([storeId, status])
  @@map("job_cards")
}

/// A part or a piece of labour on a job card: one of the shop's products (labour is a service).
model JobCardLine {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId   String   @map("store_id") @db.Uuid
  jobCardId String   @map("job_card_id") @db.Uuid
  variantId String   @map("variant_id") @db.Uuid
  quantity  Int
  note      String   @default("")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  store   Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  jobCard JobCard        @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([jobCardId])
  @@map("job_card_lines")
}

/// A restaurant's table (Features › tables): a sale at the counter can be for one.
model DineTable {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId   String   @map("store_id") @db.Uuid
  name      String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@map("dine_tables")
}

/// A field the shop added itself: on its products, or on each item sold.
model CustomFieldDefinition {
  id        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId   String            @map("store_id") @db.Uuid
  target    CustomFieldTarget
  type      CustomFieldType
  labelKm   String            @map("label_km")
  labelEn   String            @default("") @map("label_en")
  /// "pick" only: [{ id, labelKm, labelEn }].
  options   Json              @default("[]")
  required  Boolean           @default(false)
  /// Product fields only: shown on the shop page.
  public    Boolean           @default(false)
  sortOrder Int               @default(0) @map("sort_order")
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@map("custom_field_definitions")
}

/// Which values make a variant: one per variant group.
model ProductVariantValue {
  variantId String @map("variant_id") @db.Uuid
  valueId   String @map("value_id") @db.Uuid
  storeId   String @map("store_id") @db.Uuid

  store   Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variant ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  value   ProductOptionValue @relation(fields: [valueId], references: [id], onDelete: Cascade)

  @@id([variantId, valueId])
  @@index([valueId])
  @@map("product_variant_values")
}

/// A warehouse or a branch (docs/blueprint.md "Stock"). Every shop has one main branch (a trigger makes it); Advance adds more.
model StockLocation {
  id                   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId              String            @map("store_id") @db.Uuid
  type                 StockLocationType
  nameKm               String            @map("name_km")
  nameEn               String            @default("") @map("name_en")
  /// A branch's warehouse (Advance).
  suppliedByLocationId String?           @map("supplied_by_location_id") @db.Uuid
  isMain               Boolean           @default(false) @map("is_main")
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  store        Store              @relation("StoreLocations", fields: [storeId], references: [id], onDelete: Cascade)
  suppliedBy   StockLocation?     @relation("LocationSupply", fields: [suppliedByLocationId], references: [id], onDelete: SetNull)
  supplies     StockLocation[]    @relation("LocationSupply")
  levels       StockLevel[]
  stockCounts  StockCount[]
  movements    StockMovement[]
  reservations StockReservation[]
  /// The store whose shop page sells from here (Advance; null = the main branch).
  onlineFor    Store[]            @relation("StoreOnlineLocation")

  @@index([storeId])
  @@map("stock_locations")
}

/// How many are there now, per product option and location. No row = the option's stock isn't tracked.
model StockLevel {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId    String   @map("store_id") @db.Uuid
  variantId  String   @map("variant_id") @db.Uuid
  locationId String   @map("location_id") @db.Uuid
  onHand     Int      @default(0) @map("on_hand")
  /// Held for unpaid online orders (KHQR, step 5); 0 until then.
  reserved   Int      @default(0)
  /// Reorder when what's free is at or below this (empty: the shop's rule, LOW_STOCK_THRESHOLD).
  reorderMin Int?     @map("reorder_min")
  /// Order up to this many (empty: twice the minimum).
  reorderMax Int?     @map("reorder_max")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  store    Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  location StockLocation  @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([variantId, locationId])
  @@index([storeId])
  @@map("stock_levels")
}

/// The history of every change, never edited: why a level is what it is.
model StockMovement {
  id              String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId         String                 @map("store_id") @db.Uuid
  variantId       String                 @map("variant_id") @db.Uuid
  locationId      String                 @map("location_id") @db.Uuid
  type            StockMovementType
  /// Always positive; the type says which way.
  quantity        Int
  /// Adjustments only.
  reason          StockAdjustmentReason?
  /// Links a transfer's out and in halves (Advance).
  transferId      String?                @map("transfer_id") @db.Uuid
  /// Sales and their returns.
  orderId         String?                @map("order_id") @db.Uuid
  /// A purchase's cost of one, in cost_currency (docs/blueprint.md "Cost price", level 2): it moves the option's average cost. Purchases only.
  unitCostMinor   Int?                   @map("unit_cost_minor")
  costCurrency    Currency?              @map("cost_currency")
  /// Who a purchase came from ("" = not said).
  supplier        String                 @default("")
  /// The bill this purchase or return belongs to.
  purchaseId      String?                @map("purchase_id") @db.Uuid
  /// The stock count (CNT-…) a count correction came from.
  stockCountId    String?                @map("stock_count_id") @db.Uuid
  note            String                 @default("")
  actorMerchantId String?                @map("actor_merchant_id") @db.Uuid
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  store      Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  location   StockLocation  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  order      Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  purchase   Purchase?      @relation(fields: [purchaseId], references: [id], onDelete: NoAction)
  stockCount StockCount?    @relation(fields: [stockCountId], references: [id], onDelete: NoAction)
  actor      Merchant?      @relation(fields: [actorMerchantId], references: [id], onDelete: SetNull)

  @@index([storeId, createdAt])
  @@index([variantId])
  @@index([orderId])
  @@index([purchaseId])
  @@index([stockCountId])
  @@map("stock_movements")
}

/// Stock held for an order waiting to be paid online (KHQR): exactly what was held, so payment takes it and expiry gives it back.
model StockReservation {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId    String   @map("store_id") @db.Uuid
  orderId    String   @map("order_id") @db.Uuid
  variantId  String   @map("variant_id") @db.Uuid
  locationId String   @map("location_id") @db.Uuid
  quantity   Int
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  store    Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order    Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  location StockLocation  @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([orderId, variantId, locationId])
  @@index([storeId])
  @@index([variantId, locationId])
  @@map("stock_reservations")
}

/// Up to 6 per product; the first is the cover.
model ProductPhoto {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId   String   @map("store_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  fileKey   String   @map("file_key")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_photos")
}

// -------------------------------------------------------------------- delivery

/// A group of Phnom Penh districts with one fee. Both fees empty = free.
model DeliveryZone {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId     String   @map("store_id") @db.Uuid
  /// The seller's own label ("Central"); buyers see the district and the fee.
  name        String
  feeUsdCents Int?     @map("fee_usd_cents")
  feeKhr      Int?     @map("fee_khr")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  store     Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  districts DeliveryZoneDistrict[]

  @@index([storeId])
  @@map("delivery_zones")
}

/// Which districts a zone covers. A district is in one zone only.
model DeliveryZoneDistrict {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  zoneId     String   @map("zone_id") @db.Uuid
  storeId    String   @map("store_id") @db.Uuid
  /// From packages/shared locations.ts PHNOM_PENH_DISTRICTS.
  districtId String   @map("district_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  zone DeliveryZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([storeId, districtId])
  @@index([zoneId])
  @@map("delivery_zone_districts")
}

/// Drivers an order can be handed to (dispatch arrives in step 6). Never shown to buyers.
model StoreDriver {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId   String     @map("store_id") @db.Uuid
  name      String
  /// 855...
  phone     String
  kind      DriverKind
  sortOrder Int        @default(0) @map("sort_order")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  store      Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  dispatches DeliveryDispatch[]

  @@index([storeId])
  @@map("store_drivers")
}

// ------------------------------------------------------- orders and payments

/// A buyer, per store, found by phone. Written only through app_save_customer() when a buyer orders.
model Customer {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId    String        @map("store_id") @db.Uuid
  /// 855...
  phone      String
  name       String
  telegramId String?       @map("telegram_id")
  /// The last delivery choice, to fill the next checkout.
  area       DeliveryArea?
  districtId String?       @map("district_id")
  provinceId String?       @map("province_id")
  landmark   String        @default("")
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  store  Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders Order[]

  @@unique([storeId, phone])
  @@map("customers")
}

/// An order. Every amount is in `currency`, as whole cents or riel, frozen when it was placed.
model Order {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId           String             @map("store_id") @db.Uuid
  /// Empty for a walk-in buyer at the counter who gave no phone.
  customerId        String?            @map("customer_id") @db.Uuid
  orderNumber       Int                @map("order_number")
  channel           OrderChannel       @default(online)
  /// Random and long: the buyer's order page link. Never the order number.
  publicToken       String             @unique @map("public_token")
  /// 8 characters the buyer can type, with their phone, on "Track my order" (packages/shared invoice.ts).
  trackingCode      String             @unique @default(dbgenerated("app_new_tracking_code()")) @map("tracking_code")
  status            OrderStatus
  paymentMethod     PaymentMethod      @map("payment_method")
  currency          Currency
  subtotalMinor     Int                @map("subtotal_minor")
  discountMinor     Int                @map("discount_minor")
  deliveryFeeMinor  Int                @map("delivery_fee_minor")
  vatPercent        Int                @map("vat_percent")
  vatMinor          Int                @map("vat_minor")
  totalMinor        Int                @map("total_minor")
  /// The store's USD to KHR rate when the order was placed; old orders are never recomputed.
  exchangeRateUsed  Int                @map("exchange_rate_used")
  fulfilment        Fulfilment
  area              DeliveryArea
  districtId        String?            @map("district_id")
  provinceId        String?            @map("province_id")
  landmark          String             @default("")
  /// Copied from the store at order time, for pickup orders.
  pickupAddress     String             @default("") @map("pickup_address")
  pickupHours       String             @default("") @map("pickup_hours")
  /// Copied from the checkout, so the order keeps them whatever happens to the customer row.
  buyerName         String             @map("buyer_name")
  buyerPhone        String             @map("buyer_phone")
  cancelReason      OrderCancelReason? @map("cancel_reason")
  cancelNote        String             @default("") @map("cancel_note")
  /// Dine-in (Features › tables): the table's name, copied when the sale was made; "" = not for a table.
  tableName         String             @default("") @map("table_name")
  /// When the kitchen marked the order made (Kitchen screen); null = still to make.
  kitchenDoneAt     DateTime?          @map("kitchen_done_at") @db.Timestamptz(6)
  /// A cart of only services: when the buyer would like it done (null = not a booking).
  preferredAt       DateTime?          @map("preferred_at") @db.Timestamptz(6)
  /// Pro and Advance: stock was taken for this order.
  stockTaken        Boolean            @default(false) @map("stock_taken")
  /// Pro and Advance: stock is held for this order while it waits to be paid online (stock_reservations).
  stockReserved     Boolean            @default(false) @map("stock_reserved")
  /// Cash at the counter: what the buyer handed over and the change given, in the order's currency.
  cashReceivedMinor Int?               @map("cash_received_minor")
  changeMinor       Int?               @map("change_minor")
  /// Who rang up a sale at the counter.
  soldByMerchantId  String?            @map("sold_by_merchant_id") @db.Uuid
  /// Made once per checkout by the shop page; the same key twice = the same order.
  idempotencyKey    String             @map("idempotency_key") @db.Uuid
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  store             Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer          Customer?          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  soldBy            Merchant?          @relation("OrderSoldBy", fields: [soldByMerchantId], references: [id], onDelete: SetNull)
  items             OrderItem[]
  events            OrderStatusEvent[]
  dispatches        DeliveryDispatch[]
  followers         OrderFollower[]
  stockMovements    StockMovement[]
  stockReservations StockReservation[]
  paymentAttempts   PaymentAttempt[]
  jobCards          JobCard[]

  @@unique([storeId, orderNumber])
  @@unique([storeId, idempotencyKey])
  @@index([storeId, createdAt])
  /// The seller's order list filters by status.
  @@index([storeId, status])
  @@map("orders")
}

/// Every try to pay an order online (docs/blueprint.md "Payments"). Only the worker, with the provider's own status API, marks one paid.
model PaymentAttempt {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId         String               @map("store_id") @db.Uuid
  orderId         String               @map("order_id") @db.Uuid
  provider        PaymentProvider
  /// KHQR: the code's MD5; PayWay: the tran_id.
  providerRef     String               @map("provider_ref")
  /// What the buyer scans (KHQR), kept so the order page can show it again.
  qrPayload       String               @default("") @map("qr_payload")
  /// The order's total and currency when the attempt was made; paid only on an exact match.
  amountMinor     Int                  @map("amount_minor")
  currency        Currency
  status          PaymentAttemptStatus @default(pending)
  expiresAt       DateTime             @map("expires_at") @db.Timestamptz(6)
  checkCount      Int                  @default(0) @map("check_count")
  lastCheckedAt   DateTime?            @map("last_checked_at") @db.Timestamptz(6)
  paidAt          DateTime?            @map("paid_at") @db.Timestamptz(6)
  /// The provider's last answer, for an admin looking into an issue. Never secrets.
  rawResponse     Json?                @map("raw_response")
  issue           PaymentCheckIssue?
  issueStatus     PaymentIssueStatus?  @map("issue_status")
  issueNote       String               @default("") @map("issue_note")
  issueClosedById String?              @map("issue_closed_by") @db.Uuid
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  store         Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order         Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  issueClosedBy AdminUser? @relation(fields: [issueClosedById], references: [id], onDelete: SetNull)

  @@unique([provider, providerRef])
  @@index([orderId])
  @@index([storeId, createdAt])
  @@map("payment_attempts")
}

/// An order line: a snapshot, so a later rename or price change never alters an old order.
model OrderItem {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId        String   @map("store_id") @db.Uuid
  orderId        String   @map("order_id") @db.Uuid
  variantId      String   @map("variant_id") @db.Uuid
  titleKm        String   @map("title_km")
  titleEn        String   @map("title_en")
  variantLabelKm String   @default("") @map("variant_label_km")
  variantLabelEn String   @default("") @map("variant_label_en")
  /// One unit after the product's discount, in the order's currency.
  unitPriceMinor Int      @map("unit_price_minor")
  quantity       Int
  lineTotalMinor Int      @map("line_total_minor")
  /// What one unit cost the shop when sold, in the order's currency (frozen like the price); null = not known.
  unitCostMinor  Int?     @map("unit_cost_minor")
  /// The choices picked (packages/shared product-options.ts OrderLineChoice[]), frozen like the title: [] = none.
  choices        Json     @default("[]")
  /// The buyer's note on this item ("no onions").
  note           String   @default("")
  /// The shop's own fields for each item sold (target orderLine), e.g. the IMEI handed over: field id → value.
  customValues   Json     @default("{}") @map("custom_values")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  /// Best sellers and "how many of this option were sold".
  @@index([variantId])
  @@map("order_items")
}

/// The order's history: one row per status it reached. Never edited.
model OrderStatusEvent {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId         String      @map("store_id") @db.Uuid
  orderId         String      @map("order_id") @db.Uuid
  status          OrderStatus
  actor           OrderActor
  actorMerchantId String?     @map("actor_merchant_id") @db.Uuid
  at              DateTime    @default(now()) @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_status_events")
}

/// How an order was sent. A rebooked order gets a new row; the old one keeps what happened.
model DeliveryDispatch {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId      String        @map("store_id") @db.Uuid
  orderId      String        @map("order_id") @db.Uuid
  route        DispatchRoute
  /// The saved driver, if one was picked; the name and phone are copied so the order keeps them.
  driverId     String?       @map("driver_id") @db.Uuid
  driverName   String        @default("") @map("driver_name")
  driverPhone  String        @default("") @map("driver_phone")
  busCompany   String        @default("") @map("bus_company")
  ticketNumber String        @default("") @map("ticket_number")
  dispatchedAt DateTime      @default(now()) @map("dispatched_at") @db.Timestamptz(6)
  pickedUpAt   DateTime?     @map("picked_up_at") @db.Timestamptz(6)
  deliveredAt  DateTime?     @map("delivered_at") @db.Timestamptz(6)
  failedAt     DateTime?     @map("failed_at") @db.Timestamptz(6)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  order  Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driver StoreDriver? @relation(fields: [driverId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("delivery_dispatches")
}

// -------------------------------------------------------------------- telegram

/// A shop's staff Telegram group: gets the same order alerts as the shop's people.
model StoreAlertChat {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId   String   @map("store_id") @db.Uuid
  /// Telegram's id for the group (negative).
  chatId    String   @map("chat_id")
  title     String   @default("")
  /// The merchant whose link code added it.
  linkedBy  String?  @map("linked_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, chatId])
  @@index([chatId])
  @@map("store_alert_chats")
}

/// A buyer's Telegram chat following one order's status. Never a phone number.
model OrderFollower {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId   String    @map("store_id") @db.Uuid
  orderId   String    @map("order_id") @db.Uuid
  chatId    String    @map("chat_id")
  stoppedAt DateTime? @map("stopped_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, chatId])
  @@index([chatId])
  @@map("order_followers")
}

/// The one-time code behind a t.me link (start / startgroup). Only its SHA-256 is kept; 15 minutes, once.
model TelegramLinkCode {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind      TelegramLinkKind
  codeHash  String           @unique @map("code_hash")
  storeId   String           @map("store_id") @db.Uuid
  orderId   String?          @map("order_id") @db.Uuid
  createdBy String?          @map("created_by") @db.Uuid
  expiresAt DateTime         @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime?        @map("used_at") @db.Timestamptz(6)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("telegram_link_codes")
}

// ----------------------------------------------------------------------- admin

/// Who can use the admin area. Disabled, never deleted. Never readable by the API's everyday user.
model AdminUser {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  /// The Telegram account they sign in with.
  telegramId       String    @unique @map("telegram_id")
  telegramUsername String    @default("") @map("telegram_username")
  role             AdminRole
  /// The authenticator app's secret, encrypted with ADMIN_SECRETS_KEY (AES-256-GCM). Null until set up.
  totpSecretEnc    String?   @map("totp_secret_enc")
  /// A secret being set up, until the first code proves the app has it.
  totpPendingEnc   String?   @map("totp_pending_enc")
  /// The 30-second step of the last code accepted: a code is never accepted twice.
  totpLastStep     Int       @default(0) @map("totp_last_step")
  failedCodes      Int       @default(0) @map("failed_codes")
  lockedUntil      DateTime? @map("locked_until") @db.Timestamptz(6)
  disabledAt       DateTime? @map("disabled_at") @db.Timestamptz(6)
  lastActiveAt     DateTime? @map("last_active_at") @db.Timestamptz(6)
  invitedBy        String?   @map("invited_by") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  backupCodes         AdminBackupCode[]
  sessions            AdminSession[]
  closedPaymentIssues PaymentAttempt[]

  @@map("admin_users")
}

/// One-time codes for a lost phone. Only their SHA-256 is kept.
model AdminBackupCode {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminUserId String    @map("admin_user_id") @db.Uuid
  codeHash    String    @map("code_hash")
  usedAt      DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@map("admin_backup_codes")
}

/// An admin's signed-in browser. Only the token's SHA-256 is kept.
model AdminSession {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminUserId String            @map("admin_user_id") @db.Uuid
  tokenHash   String            @unique @map("token_hash")
  stage       AdminSessionStage
  expiresAt   DateTime          @map("expires_at") @db.Timestamptz(6)
  revokedAt   DateTime?         @map("revoked_at") @db.Timestamptz(6)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@map("admin_sessions")
}

// -------------------------------------------------------------------- platform

/// Messages to send (Telegram alerts), written in the same transaction as the change they report and sent by the worker.
model OutboxEvent {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId     String?   @map("store_id") @db.Uuid
  /// order_placed, order_cancelled_by_buyer
  kind        String
  /// Ids only (the worker reads the rest when it sends): never a phone number or a name.
  payload     Json
  /// Not before: a failed send waits a little longer each time.
  availableAt DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  sentAt      DateTime? @map("sent_at") @db.Timestamptz(6)
  attempts    Int       @default(0)
  lastError   String    @default("") @map("last_error")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([sentAt, availableAt])
  @@map("outbox_events")
}

/// One row of platform-wide settings (id is always 1).
model PlatformSettings {
  id                  Int       @id @default(1)
  platformName        String    @map("platform_name")
  supportTelegram     String    @map("support_telegram")
  usdToKhrMin         Int       @map("usd_to_khr_min")
  usdToKhrMax         Int       @map("usd_to_khr_max")
  alertChatId         String    @default("") @map("alert_chat_id")
  /// Release 1 beta: every shop gets Basic's features and limits. Off at Release 2, when billing starts.
  betaAllBasic        Boolean   @default(true) @map("beta_all_basic")
  /// When the monthly full-restore test (blueprint "The routine") last passed, as an owner recorded it.
  restoreTestPassedAt DateTime? @map("restore_test_passed_at") @db.Timestamptz(6)
  /// The worker's last heartbeat (every 5 minutes): the admin overview shows it down when this gets old.
  workerSeenAt        DateTime? @map("worker_seen_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("platform_settings")
}

/// Who changed what. Never edited or deleted.
model AuditLog {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorType ActorType @map("actor_type")
  actorId   String?   @map("actor_id") @db.Uuid
  storeId   String?   @map("store_id") @db.Uuid
  action    String
  entity    String
  entityId  String?   @map("entity_id")
  before    Json?
  after     Json?
  at        DateTime  @default(now()) @db.Timestamptz(6)

  @@index([storeId, at])
  @@map("audit_logs")
}

/// Request counters for rate limits (login, checkout, links, uploads): one row per key and time window.
/// The key is a scope plus a hash, never a raw IP address or phone. Only the API's
/// app_rate_limit_hit() function writes here; the worker deletes rows older than two days.
model RateLimitHit {
  bucket      String
  windowStart DateTime @map("window_start") @db.Timestamptz(6)
  hits        Int      @default(1)

  @@id([bucket, windowStart])
  @@index([windowStart])
  @@map("rate_limit_hits")
}

/// "Tell me when it's ready" on a coming-soon product page of the platform
/// website. Platform data, no store_id: written and read only through
/// SystemDb (the public waitlist endpoint and the admin). One row per phone
/// per product; signing up again updates it.
model WaitlistSignup {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// A platform product id (packages/shared PLATFORM_PRODUCT_IDS).
  product      String
  name         String
  /// Saved as 855XXXXXXXX(X), like every phone.
  phone        String
  /// packages/shared WAITLIST_BUSINESS_TYPES.
  businessType String   @map("business_type")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([product, phone])
  @@index([createdAt])
  @@map("waitlist_signups")
}

/// The database backups (admin A13): one row per nightly or manual run. Platform data, no store_id.
/// At most one is waiting or running at a time (a partial unique index in the migration).
model BackupRun {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// nightly | manual (packages/shared BACKUP_KINDS).
  kind          String
  /// queued | running | done | failed (packages/shared BACKUP_STATUSES).
  status        String
  /// The admin who pressed "Backup now"; null for nightly runs.
  startedById   String?   @map("started_by_id") @db.Uuid
  /// The backup file in S3_BACKUP_BUCKET, once done.
  objectKey     String?   @map("object_key")
  sizeBytes     BigInt?   @map("size_bytes")
  /// packages/shared BACKUP_FAILURES — a fixed reason, never the raw error.
  failure       String?
  startedAt     DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt    DateTime? @map("finished_at") @db.Timestamptz(6)
  /// Set when the file is removed after BACKUP_KEEP_DAYS; the row stays as history.
  fileDeletedAt DateTime? @map("file_deleted_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@map("backup_runs")
}

/// What a purchase is: goods bought in, or goods sent back to the supplier.
enum PurchaseKind {
  purchase
  return
}

/// A shop's supplier (docs/blueprint.md "Cost price", level 2+). Archived, never deleted, so old bills keep it.
model Supplier {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId    String    @map("store_id") @db.Uuid
  /// Unique in the shop whatever the case (a database index on lower(name)).
  name       String
  /// Saved as 855XXXXXXXX(X); "" = not given.
  phone      String    @default("")
  note       String    @default("")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  store     Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  purchases Purchase[]

  @@index([storeId])
  @@map("suppliers")
}

/// One supplier bill (or a return to the supplier), received in one go. Never edited: a mistake is fixed with a return.
model Purchase {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId          String       @map("store_id") @db.Uuid
  /// 1, 2, 3… per shop.
  number           Int
  kind             PurchaseKind @default(purchase)
  /// A return: the purchase it sends goods back from.
  returnsId        String?      @map("returns_id") @db.Uuid
  supplierId       String?      @map("supplier_id") @db.Uuid
  /// The supplier's own bill or invoice number.
  billRef          String       @default("") @map("bill_ref")
  /// The day on the bill (Phnom Penh).
  purchasedOn      DateTime     @map("purchased_on") @db.Date
  /// Bought on credit: the day it should be paid by (empty: paid now, or no date agreed).
  dueOn            DateTime?    @map("due_on") @db.Date
  /// One currency per bill: every line's product costs in it.
  currency         Currency
  totalMinor       Int          @map("total_minor")
  /// Riel per $1 used to turn this bill's prices into its items' cost currencies; empty when nothing needed turning.
  exchangeRateUsed Int?         @map("exchange_rate_used")
  /// When the goods arrived and stock went up (set once); empty: saved, not received yet. A return is always received.
  receivedAt       DateTime?    @map("received_at") @db.Timestamptz(6)
  receivedById     String?      @map("received_by_id") @db.Uuid
  note             String       @default("")
  createdById      String?      @map("created_by_id") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  store      Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  supplier   Supplier?         @relation(fields: [supplierId], references: [id], onDelete: NoAction)
  returns    Purchase?         @relation("PurchaseReturns", fields: [returnsId], references: [id], onDelete: NoAction)
  returnedBy Purchase[]        @relation("PurchaseReturns")
  createdBy  Merchant?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  receivedBy Merchant?         @relation("PurchaseReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull)
  lines      PurchaseLine[]
  payments   PurchasePayment[]
  movements  StockMovement[]

  /// Bills and returns each count from 1 (document_counters).
  @@unique([storeId, kind, number])
  @@index([storeId, purchasedOn])
  @@index([supplierId])
  @@map("purchases")
}

/// One product option on a bill: how many, and what one cost.
model PurchaseLine {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId          String    @map("store_id") @db.Uuid
  purchaseId       String    @map("purchase_id") @db.Uuid
  variantId        String    @map("variant_id") @db.Uuid
  quantity         Int
  /// In the bill's currency.
  unitCostMinor    Int       @map("unit_cost_minor")
  lineTotalMinor   Int       @map("line_total_minor")
  /// The cost of one in the item's own cost currency (what went into its average): converted at the bill's rate, or the same as unit_cost_minor. Both or neither.
  itemCostMinor    Int?      @map("item_cost_minor")
  itemCostCurrency Currency? @map("item_cost_currency")

  store    Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  purchase Purchase       @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: NoAction)

  @@index([purchaseId])
  @@index([variantId])
  @@map("purchase_lines")
}

/// Which numbered documents a shop has: each counts 1, 2, 3… on its own (shown as BILL-0001, RET-0001, PAY-0001: packages/shared documents.ts).
enum DocumentSeries {
  bill
  return
  payment
  count
}

/// The last number a shop gave out in each series; the next document takes this + 1 in the same statement, so two at once never share one.
model DocumentCounter {
  storeId    String         @map("store_id") @db.Uuid
  series     DocumentSeries
  lastNumber Int            @default(0) @map("last_number")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([storeId, series])
  @@map("document_counters")
}

/// How a supplier bill was paid.
enum PurchasePaymentMethod {
  cash
  bank
  khqr
  other
}

/// Money paid to a supplier against one bill, in the bill's currency (PAY-0001…). Never edited or deleted: one paid by mistake is voided, and stays in the history.
model PurchasePayment {
  id          String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId     String                @map("store_id") @db.Uuid
  purchaseId  String                @map("purchase_id") @db.Uuid
  /// 1, 2, 3… per shop (document_counters, series payment).
  number      Int
  /// The day it was paid (Phnom Penh).
  paidOn      DateTime              @map("paid_on") @db.Date
  /// In the bill's currency: cents or riel.
  amountMinor Int                   @map("amount_minor")
  method      PurchasePaymentMethod
  note        String                @default("")
  createdById String?               @map("created_by_id") @db.Uuid
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Set once, when it's voided; the only thing about a payment that changes.
  voidedAt    DateTime?             @map("voided_at") @db.Timestamptz(6)
  voidedById  String?               @map("voided_by_id") @db.Uuid

  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  purchase  Purchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  createdBy Merchant? @relation("PaymentRecordedBy", fields: [createdById], references: [id], onDelete: SetNull)
  voidedBy  Merchant? @relation("PaymentVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)

  @@unique([storeId, number])
  @@index([purchaseId])
  @@map("purchase_payments")
}

enum StockCountStatus {
  draft
  applied
  cancelled
}

/// A stock count (design/screens.md S13 "Count stock"): a numbered document (CNT-…) of what's on the shelf, over every item or chosen categories. Left as a draft and continued on any device; applied once (each correction counted − expected, onto today's stock) or cancelled. Never deleted; at most one draft per shop.
model StockCount {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId       String           @map("store_id") @db.Uuid
  number        Int
  status        StockCountStatus @default(draft)
  locationId    String           @map("location_id") @db.Uuid
  /// The categories counted; empty = every item.
  categoryIds   String[]         @default([]) @map("category_ids") @db.Uuid
  note          String           @default("")
  startedAt     DateTime         @default(now()) @map("started_at") @db.Timestamptz(6)
  startedById   String?          @map("started_by_id") @db.Uuid
  appliedAt     DateTime?        @map("applied_at") @db.Timestamptz(6)
  appliedById   String?          @map("applied_by_id") @db.Uuid
  cancelledAt   DateTime?        @map("cancelled_at") @db.Timestamptz(6)
  cancelledById String?          @map("cancelled_by_id") @db.Uuid

  store       Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  location    StockLocation    @relation(fields: [locationId], references: [id], onDelete: Restrict)
  startedBy   Merchant?        @relation("CountStartedBy", fields: [startedById], references: [id], onDelete: SetNull)
  appliedBy   Merchant?        @relation("CountAppliedBy", fields: [appliedById], references: [id], onDelete: SetNull)
  cancelledBy Merchant?        @relation("CountCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  lines       StockCountLine[]
  movements   StockMovement[]

  @@unique([storeId, number])
  @@index([storeId, startedAt])
  @@map("stock_counts")
}

/// One item counted in a stock count: what's on the shelf, and what the app had for it the moment it was typed (blank: it wasn't tracked). The cost is fixed when the count is applied, so its value never changes after.
model StockCountLine {
  countId        String    @map("count_id") @db.Uuid
  storeId        String    @map("store_id") @db.Uuid
  variantId      String    @map("variant_id") @db.Uuid
  counted        Int
  expectedOnHand Int?      @map("expected_on_hand")
  countedAt      DateTime  @default(now()) @map("counted_at") @db.Timestamptz(6)
  costMinor      Int?      @map("cost_minor")
  costCurrency   Currency? @map("cost_currency")

  count   StockCount     @relation(fields: [countId], references: [id], onDelete: Cascade)
  store   Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@id([countId, variantId])
  @@index([storeId])
  @@map("stock_count_lines")
}

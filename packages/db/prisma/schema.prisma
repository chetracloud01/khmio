// The database, following docs/blueprint.md "Database schema". Each roadmap
// step adds its own tables in a new migration; old migrations are never edited.
// Step 2 (data and login): people, login, stores, the trial subscription,
// categories and units, sessions, platform settings and the audit log.
// Step 3 (catalog): brands, products, variants, photos.
// Step 4 (shop and checkout): delivery zones and drivers, customers, orders.
// Step 6 (orders and Telegram): how each order was sent, and the outbox of messages.
// Step 7 (admin): admin users with two-step login, their backup codes and sessions.
// Release 1 complete: staff Telegram groups, buyers following an order, one-time Telegram link codes.
//
// Row-level security (in the migration SQL, which Prisma can't express) keeps
// every shop to its own rows for the API's everyday user, khmer_micro_store_app.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // The API's everyday user: row-level security applies.
  url       = env("DATABASE_URL")
  // The owner: migrations run as this user.
  directUrl = env("DATABASE_OWNER_URL")
}

// ---------------------------------------------------------------- value lists
// Same names as packages/shared, so a value means the same thing everywhere.

enum KycStatus {
  not_submitted
  pending
  approved
  rejected
}

enum LoginMethod {
  telegram
  phone
  google
}

enum StoreRole {
  owner
  staff
}

enum BusinessType {
  shop
  restaurant
  service
  garage
  other
}

enum DeliveryArea {
  phnom_penh
  province
}

enum Currency {
  USD
  KHR
}

enum PaymentProvider {
  bakong_khqr
  aba_payway
}

enum PlanId {
  free
  basic
  pro
  advance
}

enum SubscriptionStatus {
  trialing
  active
  grace
  paused
}

enum ActorType {
  admin
  merchant
  system
}

enum OrderStatus {
  awaiting_payment
  paid
  cod_pending
  confirmed
  packing
  waiting_for_driver
  out_for_delivery
  delivered
  completed
  cancelled
  failed_delivery
}

enum PaymentMethod {
  khqr
  aba_payway
  cod
}

enum Fulfilment {
  delivery
  pickup
}

enum DriverKind {
  own
  partner
}

enum OrderCancelReason {
  payment_timeout
  buyer_cancelled
  out_of_stock
  cannot_deliver
  other
}

enum OrderActor {
  buyer
  merchant
  system
}

enum DispatchRoute {
  driver
  bus
  pickup
}

enum AdminRole {
  owner
  support
  finance
}

enum TelegramLinkKind {
  /// "Add the bot to your staff group": links a group to a shop.
  group_link
  /// "Get updates on Telegram": links a buyer's chat to an order.
  order_follow
}

enum AdminSessionStage {
  /// Telegram (or the development login) passed; the authenticator code is still to come.
  pending_2fa
  active
}

// ---------------------------------------------------------- people and login

/// A person who owns or works in stores.
model Merchant {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName String    @map("first_name")
  lastName  String    @default("") @map("last_name")
  kycStatus KycStatus @default(not_submitted) @map("kyc_status")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  identities  MerchantIdentity[]
  memberships StoreMember[]
  sessions    Session[]

  @@map("merchants")
}

/// How a merchant logs in — one row per method. A merchant always keeps at least one.
model MerchantIdentity {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId       String      @map("merchant_id") @db.Uuid
  method           LoginMethod
  /// Telegram user ID, or the phone as 855…
  providerUserId   String      @map("provider_user_id")
  telegramUsername String?     @map("telegram_username")
  verifiedAt       DateTime    @default(now()) @map("verified_at") @db.Timestamptz(6)
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([method, providerUserId])
  @@index([merchantId])
  @@map("merchant_identities")
}

/// A signed-in device. The cookie holds a random token; only its SHA-256 is stored.
model Session {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId String    @map("merchant_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@map("sessions")
}

/// Who can manage a store.
model StoreMember {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId    String    @map("store_id") @db.Uuid
  merchantId String    @map("merchant_id") @db.Uuid
  role       StoreRole @default(owner)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([storeId, merchantId])
  @@index([merchantId])
  @@map("store_members")
}

// ----------------------------------------------------------------------- shop

/// A shop. The plan is not here — it lives on subscriptions only.
model Store {
  id                      String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                    String       @unique
  name                    String
  businessType            BusinessType @map("business_type")
  /// 855…; empty until the seller adds it (needed before sharing the shop link).
  phone                   String       @default("")
  area                    DeliveryArea @default(phnom_penh)
  description             String       @default("")
  logoKey                 String?      @map("logo_key")
  languages               String[]     @default(["km", "en"])
  defaultCurrency         Currency     @default(USD) @map("default_currency")
  usdToKhrRate            Int          @default(4100) @map("usd_to_khr_rate")
  allowCod                Boolean      @default(true) @map("allow_cod")
  /// Most small sellers don't charge VAT, so a new store starts at 0%.
  vatPercent              Int          @default(0) @map("vat_percent")
  onlineStockLocationId   String?      @map("online_stock_location_id") @db.Uuid
  pickupEnabled           Boolean      @default(false) @map("pickup_enabled")
  pickupAddress           String       @default("") @map("pickup_address")
  pickupHours             String       @default("") @map("pickup_hours")
  provinceDeliveryEnabled Boolean      @default(false) @map("province_delivery_enabled")
  provinceFeeUsdCents     Int?         @map("province_fee_usd_cents")
  provinceFeeKhr          Int?         @map("province_fee_khr")
  provinceNote            String       @default("") @map("province_note")
  deliveryConfiguredAt    DateTime?    @map("delivery_configured_at") @db.Timestamptz(6)
  linkSharedAt            DateTime?    @map("link_shared_at") @db.Timestamptz(6)
  /// On invoices (design/screens.md B7); empty = not shown.
  taxNumber               String       @default("") @map("tax_number")
  invoiceNote             String       @default("") @map("invoice_note")
  telegramLink            String       @default("") @map("telegram_link")
  facebookLink            String       @default("") @map("facebook_link")
  /// Copied from Google Maps on Shop details; the buyer's Map button opens it (design/screens.md S10). Empty = search the pickup address.
  mapUrl                  String       @default("") @map("map_url")
  /// The last order number given out; the next order takes this + 1 (app_next_order_number()).
  lastOrderNumber         Int          @default(0) @map("last_order_number")
  createdAt               DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  members        StoreMember[]
  paymentConfigs StorePaymentConfig[]
  subscription   Subscription?
  categories     Category[]
  units          Unit[]
  brands         Brand[]
  products       Product[]
  deliveryZones  DeliveryZone[]
  drivers        StoreDriver[]
  customers      Customer[]
  orders         Order[]
  alertChats     StoreAlertChat[]

  @@map("stores")
}

/// Provider settings per store. PayWay's keys join this table in Release 3, encrypted.
model StorePaymentConfig {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId         String          @map("store_id") @db.Uuid
  provider        PaymentProvider
  bakongAccountId String?         @map("bakong_account_id")
  enabled         Boolean         @default(true)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, provider])
  @@map("store_payment_configs")
}

// ------------------------------------------------------------ plan and billing

/// A store's current plan and period — the only place the plan is stored.
model Subscription {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId            String             @unique @map("store_id") @db.Uuid
  plan               PlanId             @default(free)
  status             SubscriptionStatus @default(trialing)
  currentPeriodStart DateTime           @default(now()) @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd   DateTime?          @map("current_period_end") @db.Timestamptz(6)
  trialEndsAt        DateTime?          @map("trial_ends_at") @db.Timestamptz(6)
  pendingPlan        PlanId?            @map("pending_plan")
  billingCurrency    Currency           @default(USD) @map("billing_currency")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

// --------------------------------------------------------------------- catalog

/// A store's product groups. Products arrive in roadmap step 3.
model Category {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId   String   @map("store_id") @db.Uuid
  nameKm    String   @map("name_km")
  nameEn    String   @map("name_en")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([storeId])
  @@map("categories")
}

/// Units of measure (piece, cup, kg).
model Unit {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId   String   @map("store_id") @db.Uuid
  /// The shared key it was seeded from ("piece"), so the business type's default can be found.
  key       String?
  nameKm    String   @map("name_km")
  nameEn    String   @map("name_en")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([storeId])
  @@map("units")
}

/// A store's brands.
model Brand {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId   String   @map("store_id") @db.Uuid
  nameKm    String   @map("name_km")
  nameEn    String   @map("name_en")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([storeId])
  @@map("brands")
}

/// What the shop sells. Prices live on its variants: every product has at least one.
model Product {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId         String    @map("store_id") @db.Uuid
  categoryId      String    @map("category_id") @db.Uuid
  brandId         String?   @map("brand_id") @db.Uuid
  unitId          String?   @map("unit_id") @db.Uuid
  titleKm         String    @map("title_km")
  titleEn         String    @map("title_en")
  descriptionKm   String    @default("") @map("description_km")
  descriptionEn   String    @default("") @map("description_en")
  /// 0–90; null = no discount.
  discountPercent Int?      @map("discount_percent")
  /// False = kept in the dashboard, not shown in the shop.
  isVisible       Boolean   @default(true) @map("is_visible")
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  store    Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand    Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  unit     Unit?            @relation(fields: [unitId], references: [id], onDelete: SetNull)
  variants ProductVariant[]
  photos   ProductPhoto[]

  @@index([storeId, deletedAt])
  @@map("products")
}

/// The thing that is priced, stocked and ordered. A product without options has one default variant.
model ProductVariant {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId                String    @map("store_id") @db.Uuid
  productId              String    @map("product_id") @db.Uuid
  sku                    String
  labelKm                String    @default("") @map("label_km")
  labelEn                String    @default("") @map("label_en")
  /// The hidden variant of a product without options.
  isDefault              Boolean   @default(false) @map("is_default")
  priceUsdCents          Int?      @map("price_usd_cents")
  priceKhr               Int?      @map("price_khr")
  /// Pro and Advance; kept, hidden, on lower plans.
  wholesalePriceUsdCents Int?      @map("wholesale_price_usd_cents")
  wholesalePriceKhr      Int?      @map("wholesale_price_khr")
  sortOrder              Int       @default(0) @map("sort_order")
  deletedAt              DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_variants")
}

/// Up to 6 per product; the first is the cover.
model ProductPhoto {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId   String   @map("store_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  fileKey   String   @map("file_key")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_photos")
}

// -------------------------------------------------------------------- delivery

/// A group of Phnom Penh districts with one fee. Both fees empty = free.
model DeliveryZone {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId     String   @map("store_id") @db.Uuid
  /// The seller's own label ("Central"); buyers see the district and the fee.
  name        String
  feeUsdCents Int?     @map("fee_usd_cents")
  feeKhr      Int?     @map("fee_khr")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  store     Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  districts DeliveryZoneDistrict[]

  @@index([storeId])
  @@map("delivery_zones")
}

/// Which districts a zone covers. A district is in one zone only.
model DeliveryZoneDistrict {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  zoneId     String   @map("zone_id") @db.Uuid
  storeId    String   @map("store_id") @db.Uuid
  /// From packages/shared locations.ts PHNOM_PENH_DISTRICTS.
  districtId String   @map("district_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  zone DeliveryZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([storeId, districtId])
  @@index([zoneId])
  @@map("delivery_zone_districts")
}

/// Drivers an order can be handed to (dispatch arrives in step 6). Never shown to buyers.
model StoreDriver {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId   String     @map("store_id") @db.Uuid
  name      String
  /// 855...
  phone     String
  kind      DriverKind
  sortOrder Int        @default(0) @map("sort_order")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  store      Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  dispatches DeliveryDispatch[]

  @@index([storeId])
  @@map("store_drivers")
}

// ------------------------------------------------------- orders and payments

/// A buyer, per store, found by phone. Written only through app_save_customer() when a buyer orders.
model Customer {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId    String        @map("store_id") @db.Uuid
  /// 855...
  phone      String
  name       String
  telegramId String?       @map("telegram_id")
  /// The last delivery choice, to fill the next checkout.
  area       DeliveryArea?
  districtId String?       @map("district_id")
  provinceId String?       @map("province_id")
  landmark   String        @default("")
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  store  Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders Order[]

  @@unique([storeId, phone])
  @@map("customers")
}

/// An order. Every amount is in `currency`, as whole cents or riel, frozen when it was placed.
model Order {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId          String             @map("store_id") @db.Uuid
  customerId       String             @map("customer_id") @db.Uuid
  orderNumber      Int                @map("order_number")
  /// Random and long: the buyer's order page link. Never the order number.
  publicToken      String             @unique @map("public_token")
  /// 8 characters the buyer can type, with their phone, on "Track my order" (packages/shared invoice.ts).
  trackingCode     String             @unique @default(dbgenerated("app_new_tracking_code()")) @map("tracking_code")
  status           OrderStatus
  paymentMethod    PaymentMethod      @map("payment_method")
  currency         Currency
  subtotalMinor    Int                @map("subtotal_minor")
  discountMinor    Int                @map("discount_minor")
  deliveryFeeMinor Int                @map("delivery_fee_minor")
  vatPercent       Int                @map("vat_percent")
  vatMinor         Int                @map("vat_minor")
  totalMinor       Int                @map("total_minor")
  /// The store's USD to KHR rate when the order was placed; old orders are never recomputed.
  exchangeRateUsed Int                @map("exchange_rate_used")
  fulfilment       Fulfilment
  area             DeliveryArea
  districtId       String?            @map("district_id")
  provinceId       String?            @map("province_id")
  landmark         String             @default("")
  /// Copied from the store at order time, for pickup orders.
  pickupAddress    String             @default("") @map("pickup_address")
  pickupHours      String             @default("") @map("pickup_hours")
  /// Copied from the checkout, so the order keeps them whatever happens to the customer row.
  buyerName        String             @map("buyer_name")
  buyerPhone       String             @map("buyer_phone")
  cancelReason     OrderCancelReason? @map("cancel_reason")
  cancelNote       String             @default("") @map("cancel_note")
  /// Pro and Advance: stock was taken for this order.
  stockTaken       Boolean            @default(false) @map("stock_taken")
  /// Made once per checkout by the shop page; the same key twice = the same order.
  idempotencyKey   String             @map("idempotency_key") @db.Uuid
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  store      Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer   Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items      OrderItem[]
  events     OrderStatusEvent[]
  dispatches DeliveryDispatch[]
  followers  OrderFollower[]

  @@unique([storeId, orderNumber])
  @@unique([storeId, idempotencyKey])
  @@index([storeId, createdAt])
  @@map("orders")
}

/// An order line: a snapshot, so a later rename or price change never alters an old order.
model OrderItem {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId        String   @map("store_id") @db.Uuid
  orderId        String   @map("order_id") @db.Uuid
  variantId      String   @map("variant_id") @db.Uuid
  titleKm        String   @map("title_km")
  titleEn        String   @map("title_en")
  variantLabelKm String   @default("") @map("variant_label_km")
  variantLabelEn String   @default("") @map("variant_label_en")
  /// One unit after the product's discount, in the order's currency.
  unitPriceMinor Int      @map("unit_price_minor")
  quantity       Int
  lineTotalMinor Int      @map("line_total_minor")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_items")
}

/// The order's history: one row per status it reached. Never edited.
model OrderStatusEvent {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId         String      @map("store_id") @db.Uuid
  orderId         String      @map("order_id") @db.Uuid
  status          OrderStatus
  actor           OrderActor
  actorMerchantId String?     @map("actor_merchant_id") @db.Uuid
  at              DateTime    @default(now()) @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_status_events")
}

/// How an order was sent. A rebooked order gets a new row; the old one keeps what happened.
model DeliveryDispatch {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId      String        @map("store_id") @db.Uuid
  orderId      String        @map("order_id") @db.Uuid
  route        DispatchRoute
  /// The saved driver, if one was picked; the name and phone are copied so the order keeps them.
  driverId     String?       @map("driver_id") @db.Uuid
  driverName   String        @default("") @map("driver_name")
  driverPhone  String        @default("") @map("driver_phone")
  busCompany   String        @default("") @map("bus_company")
  ticketNumber String        @default("") @map("ticket_number")
  dispatchedAt DateTime      @default(now()) @map("dispatched_at") @db.Timestamptz(6)
  pickedUpAt   DateTime?     @map("picked_up_at") @db.Timestamptz(6)
  deliveredAt  DateTime?     @map("delivered_at") @db.Timestamptz(6)
  failedAt     DateTime?     @map("failed_at") @db.Timestamptz(6)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  order  Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driver StoreDriver? @relation(fields: [driverId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("delivery_dispatches")
}

// -------------------------------------------------------------------- telegram

/// A shop's staff Telegram group: gets the same order alerts as the shop's people.
model StoreAlertChat {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId   String   @map("store_id") @db.Uuid
  /// Telegram's id for the group (negative).
  chatId    String   @map("chat_id")
  title     String   @default("")
  /// The merchant whose link code added it.
  linkedBy  String?  @map("linked_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, chatId])
  @@index([chatId])
  @@map("store_alert_chats")
}

/// A buyer's Telegram chat following one order's status. Never a phone number.
model OrderFollower {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId   String    @map("store_id") @db.Uuid
  orderId   String    @map("order_id") @db.Uuid
  chatId    String    @map("chat_id")
  stoppedAt DateTime? @map("stopped_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, chatId])
  @@index([chatId])
  @@map("order_followers")
}

/// The one-time code behind a t.me link (start / startgroup). Only its SHA-256 is kept; 15 minutes, once.
model TelegramLinkCode {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind      TelegramLinkKind
  codeHash  String           @unique @map("code_hash")
  storeId   String           @map("store_id") @db.Uuid
  orderId   String?          @map("order_id") @db.Uuid
  createdBy String?          @map("created_by") @db.Uuid
  expiresAt DateTime         @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime?        @map("used_at") @db.Timestamptz(6)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("telegram_link_codes")
}

// ----------------------------------------------------------------------- admin

/// Who can use the admin area. Disabled, never deleted. Never readable by the API's everyday user.
model AdminUser {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  /// The Telegram account they sign in with.
  telegramId       String    @unique @map("telegram_id")
  telegramUsername String    @default("") @map("telegram_username")
  role             AdminRole
  /// The authenticator app's secret, encrypted with ADMIN_SECRETS_KEY (AES-256-GCM). Null until set up.
  totpSecretEnc    String?   @map("totp_secret_enc")
  /// A secret being set up, until the first code proves the app has it.
  totpPendingEnc   String?   @map("totp_pending_enc")
  /// The 30-second step of the last code accepted: a code is never accepted twice.
  totpLastStep     Int       @default(0) @map("totp_last_step")
  failedCodes      Int       @default(0) @map("failed_codes")
  lockedUntil      DateTime? @map("locked_until") @db.Timestamptz(6)
  disabledAt       DateTime? @map("disabled_at") @db.Timestamptz(6)
  lastActiveAt     DateTime? @map("last_active_at") @db.Timestamptz(6)
  invitedBy        String?   @map("invited_by") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  backupCodes AdminBackupCode[]
  sessions    AdminSession[]

  @@map("admin_users")
}

/// One-time codes for a lost phone. Only their SHA-256 is kept.
model AdminBackupCode {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminUserId String    @map("admin_user_id") @db.Uuid
  codeHash    String    @map("code_hash")
  usedAt      DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@map("admin_backup_codes")
}

/// An admin's signed-in browser. Only the token's SHA-256 is kept.
model AdminSession {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminUserId String            @map("admin_user_id") @db.Uuid
  tokenHash   String            @unique @map("token_hash")
  stage       AdminSessionStage
  expiresAt   DateTime          @map("expires_at") @db.Timestamptz(6)
  revokedAt   DateTime?         @map("revoked_at") @db.Timestamptz(6)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@map("admin_sessions")
}

// -------------------------------------------------------------------- platform

/// Messages to send (Telegram alerts), written in the same transaction as the change they report and sent by the worker.
model OutboxEvent {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId     String?   @map("store_id") @db.Uuid
  /// order_placed, order_cancelled_by_buyer
  kind        String
  /// Ids only (the worker reads the rest when it sends): never a phone number or a name.
  payload     Json
  /// Not before: a failed send waits a little longer each time.
  availableAt DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  sentAt      DateTime? @map("sent_at") @db.Timestamptz(6)
  attempts    Int       @default(0)
  lastError   String    @default("") @map("last_error")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([sentAt, availableAt])
  @@map("outbox_events")
}

/// One row of platform-wide settings (id is always 1).
model PlatformSettings {
  id              Int      @id @default(1)
  platformName    String   @map("platform_name")
  supportTelegram String   @map("support_telegram")
  usdToKhrMin     Int      @map("usd_to_khr_min")
  usdToKhrMax     Int      @map("usd_to_khr_max")
  alertChatId     String   @default("") @map("alert_chat_id")
  /// Release 1 beta: every shop gets Basic's features and limits. Off at Release 2, when billing starts.
  betaAllBasic    Boolean  @default(true) @map("beta_all_basic")
  /// When the monthly full-restore test (blueprint "The routine") last passed, as an owner recorded it.
  restoreTestPassedAt DateTime? @map("restore_test_passed_at") @db.Timestamptz(6)
  /// The worker's last heartbeat (every 5 minutes): the admin overview shows it down when this gets old.
  workerSeenAt        DateTime? @map("worker_seen_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("platform_settings")
}

/// Who changed what. Never edited or deleted.
model AuditLog {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorType ActorType @map("actor_type")
  actorId   String?   @map("actor_id") @db.Uuid
  storeId   String?   @map("store_id") @db.Uuid
  action    String
  entity    String
  entityId  String?   @map("entity_id")
  before    Json?
  after     Json?
  at        DateTime  @default(now()) @db.Timestamptz(6)

  @@index([storeId, at])
  @@map("audit_logs")
}

/// Request counters for rate limits (login, checkout, links, uploads): one row per key and time window.
/// The key is a scope plus a hash, never a raw IP address or phone. Only the API's
/// app_rate_limit_hit() function writes here; the worker deletes rows older than two days.
model RateLimitHit {
  bucket      String
  windowStart DateTime @map("window_start") @db.Timestamptz(6)
  hits        Int      @default(1)

  @@id([bucket, windowStart])
  @@index([windowStart])
  @@map("rate_limit_hits")
}

/// "Tell me when it's ready" on a coming-soon product page of the platform
/// website. Platform data, no store_id: written and read only through
/// SystemDb (the public waitlist endpoint and the admin). One row per phone
/// per product; signing up again updates it.
model WaitlistSignup {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// A platform product id (packages/shared PLATFORM_PRODUCT_IDS).
  product      String
  name         String
  /// Saved as 855XXXXXXXX(X), like every phone.
  phone        String
  /// packages/shared WAITLIST_BUSINESS_TYPES.
  businessType String   @map("business_type")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([product, phone])
  @@index([createdAt])
  @@map("waitlist_signups")
}

/// The database backups (admin A13): one row per nightly or manual run. Platform data, no store_id.
/// At most one is waiting or running at a time (a partial unique index in the migration).
model BackupRun {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// nightly | manual (packages/shared BACKUP_KINDS).
  kind          String
  /// queued | running | done | failed (packages/shared BACKUP_STATUSES).
  status        String
  /// The admin who pressed "Backup now"; null for nightly runs.
  startedById   String?   @map("started_by_id") @db.Uuid
  /// The backup file in S3_BACKUP_BUCKET, once done.
  objectKey     String?   @map("object_key")
  sizeBytes     BigInt?   @map("size_bytes")
  /// packages/shared BACKUP_FAILURES — a fixed reason, never the raw error.
  failure       String?
  startedAt     DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt    DateTime? @map("finished_at") @db.Timestamptz(6)
  /// Set when the file is removed after BACKUP_KEEP_DAYS; the row stays as history.
  fileDeletedAt DateTime? @map("file_deleted_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@map("backup_runs")
}

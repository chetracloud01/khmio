{
  "name": "@khmio/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "prisma": "node --env-file-if-exists=../../.env ./node_modules/prisma/build/index.js",
    "generate": "prisma generate",
    "postinstall": "prisma generate",
    "migrate:dev": "pnpm prisma migrate dev",
    "migrate:deploy": "pnpm prisma migrate deploy",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file-if-exists=../../.env ./node_modules/vitest/vitest.mjs run --passWithNoTests"
  },
  "dependencies": {
    "@khmio/shared": "workspace:*",
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "prisma": "^5.22.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}

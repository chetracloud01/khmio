{
  "name": "@khmio/worker",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsup",
    "start": "node --enable-source-maps dist/index.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file-if-exists=../../.env ./node_modules/vitest/vitest.mjs run --passWithNoTests",
    "backup": "tsx --env-file-if-exists=../../.env src/cli/backup.ts",
    "restore": "tsx --env-file-if-exists=../../.env src/cli/restore.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3",
    "@aws-sdk/lib-storage": "^3",
    "@khmio/db": "workspace:^",
    "@khmio/payments": "workspace:^",
    "@khmio/shared": "workspace:*",
    "@prisma/client": "5.22.0",
    "@sentry/node": "^8",
    "pg-boss": "^10",
    "pino": "^9",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "eslint": "^10.13.0",
    "tsup": "^8",
    "tsx": "^4.19.1",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}

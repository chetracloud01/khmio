{
  "name": "@khmio/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "tsup",
    "start": "node --enable-source-maps dist/main.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "admin:add-owner": "tsx --env-file-if-exists=../../.env src/cli/add-owner.ts",
    "files": "tsx --env-file-if-exists=../../.env src/cli/files.ts",
    "demo:garage": "tsx --env-file-if-exists=../../.env src/cli/demo-garage.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3",
    "@khmio/db": "workspace:^",
    "@khmio/payments": "workspace:^",
    "@khmio/shared": "workspace:*",
    "@nestjs/common": "^10.4.6",
    "@nestjs/core": "^10.4.6",
    "@nestjs/platform-express": "^10.4.6",
    "@prisma/client": "5.22.0",
    "@sentry/node": "^8",
    "multer": "2.0.2",
    "pino": "^9",
    "pino-http": "^10",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/multer": "^1",
    "@types/node": "^22.9.0",
    "eslint": "^10.13.0",
    "tsup": "^8",
    "tsx": "^4.19.1",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
